# =============================================================================
# NIKA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# NEVER commit .env to version control — it is listed in .gitignore.
# For EAS builds, set all EXPO_PUBLIC_* values as EAS Secrets (see below).
#
# Variable naming rules:
#   EXPO_PUBLIC_*   → baked into the client bundle at build time by Metro.
#                     Safe for Firebase client config and public API tokens.
#   (no prefix)     → server-side only (scripts, cron jobs, Cloud Functions).
#                     NEVER reference these inside the Expo/React Native app.
# =============================================================================


# -----------------------------------------------------------------------------
# App Environment
# Set automatically by EAS build profiles. Override locally if needed.
# Values: development | preview | production
# -----------------------------------------------------------------------------
APP_ENV=development


# -----------------------------------------------------------------------------
# Firebase — Client-side configuration  (EXPO_PUBLIC_ → goes to client bundle)
# Find these in:
#   Firebase Console → Project Settings → Your apps → Web app → SDK setup
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=        # Optional — only if using Analytics


# -----------------------------------------------------------------------------
# OpenRouter — Client-side  (EXPO_PUBLIC_ → goes to client bundle)
# Find these in: https://openrouter.ai/keys
# EXPO_PUBLIC_OPENROUTER_API_KEY is a *publishable* key with restricted
# permissions. If your key has full access, consider proxying calls through
# a backend instead of exposing it in the bundle.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_SITE_URL=            # e.g. https://nika.app
EXPO_PUBLIC_OPENROUTER_APP_NAME=            # e.g. Nika


# -----------------------------------------------------------------------------
# OpenRouter — Server-side only  (NO EXPO_PUBLIC_ prefix)
# Used by scripts and cron jobs (e.g. scripts/wraps-cron.js).
# Never import or reference this inside the Expo/React Native app.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=


# -----------------------------------------------------------------------------
# Firebase Admin SDK — Server-side only  (NO EXPO_PUBLIC_ prefix)
# Used by scripts and cron jobs that call firebase-admin.
# Never import or reference these inside the Expo/React Native app.
#
# Option A — path to a local service account JSON file (development only):
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json
#
# Option B — inline values (preferred for CI / EAS environment secrets):
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=              # Wrap in double quotes if it contains \n newlines
# -----------------------------------------------------------------------------
