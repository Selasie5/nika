secrets/*.json


*.jks          # Android keystore
*.keystore     # Android keystore (alternate extension)
*.p8           # Apple push notification key
*.p12          # Apple distribution certificate
*.key          # Private keys
*.pem          # PEM certificates / keys
*.mobileprovision   # Apple provisioning profiles
*.cer          # Apple certificates
*.certSigningRequest



credentials.json
